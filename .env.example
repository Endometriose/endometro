# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for Endometriômetro
VITE_SUPABASE_URL=https://qteothflfbxlhlrvmeqz.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_INCLUIR_DADOS_TESTE=false

# ==========================================
# CONFIGURAÇÕES E CHAVES DO GITHUB
# ==========================================
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
VITE_GITHUB_TOKEN=

# Informações do repositório no GitHub:
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_URL=https://github.com/Endometriose/endometro.git
GITHUB_BRANCH=main

# Credenciais de OAuth do GitHub (se utilizar login/integração via aplicativo OAuth):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
